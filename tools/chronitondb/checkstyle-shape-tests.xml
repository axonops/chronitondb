<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Shape limits for ChronitonDB tests and benchmarks under org/chronitondb
  (test/unit, test/distributed, test/microbench, test/burn and the rest of
  test/). Owner decision M5: measured, shown in the PR evidence, warnings
  only. Nothing in this file blocks a commit or a PR. Testing a database
  needs clusters, flushes, compactions and failure injection, so long
  setup is expected here.

  Checkstyle cannot tell a test method from a helper, so the method limits
  apply to every method in a test file.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- M5: file length 1,000 lines -->
  <module name="FileLength">
    <property name="max" value="1000"/>
  </module>

  <module name="TreeWalker">

    <!-- M5: cyclomatic complexity 5 per test method, a switch counts once -->
    <module name="CyclomaticComplexity">
      <property name="max" value="5"/>
      <property name="switchBlockAsSingleDecisionPoint" value="true"/>
    </module>

    <!-- M5: method length 150 lines, blank and comment lines included -->
    <module name="MethodLength">
      <property name="max" value="150"/>
      <property name="countEmpty" value="true"/>
    </module>

  </module>
</module>
